<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission: the only thing that ever leaves this device is an SMS.
         ML Kit's telemetry backend (com.google.android.datatransport:transport-backend-cct)
         and WorkManager declare network permissions in their own manifests; the merger
         removes them here, so the merged manifest of every variant has no network path.
         .github/scripts/manifest-check.sh fails CI if one ever comes back. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Default SMS app mode (T14, optional, off by default). Android grants the role only
         to an app that declares these three and the four components below. READ_SMS is used
         to list ordinary texts while Impart holds the role; the alert pipeline never reads
         the provider. Only these three were approved (brief, T14 step 3). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <!-- Lets the readiness card ask for a battery-optimization exemption directly. OEM
         battery savers are the documented number-one reason the receiver never runs. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets every Impart window hide other apps' overlays on Android 12+ (tapjacking, A5-2).
         Normal permission, no prompt, no data. Approved by Joel on 2026-11-04. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Hardware is optional: a node without a camera can still receive panics (it just
         cannot scan a handshake QR). Telephony is what the transport rides on, but marking
         it required would drop tablets that only ever need to receive. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- allowBackup is off on purpose. The Tink keyset and the encrypted preferences are
         wrapped by keys that live only in this device's Keystore; restoring them onto
         another device produces an app that crashes on its first preferences read.
         Android 12+ ignores allowBackup for device-to-device transfer, hence the rules. -->
    <application
        android:name=".ImpartApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Impart">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".MainActivityAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator"
            android:roundIcon="@mipmap/ic_launcher_calculator"
            android:label="@string/cloak_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- singleTop: a second panic while the alarm is showing updates the existing
             screen instead of stacking a second alarm activity on top of it. -->
        <activity
            android:name=".presentation.intrusion.IntrusionActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            tools:targetApi="27" />

        <!-- BROADCAST_SMS is held only by the telephony stack, so no other app can deliver a
             forged SMS_RECEIVED broadcast to this receiver.
             priority 999: SMS_RECEIVED is an ordered broadcast and the stock Messages app
             listens at the default priority. The highest priority sees the text first, so an
             alert is verified before any other app has handled it. It cannot abort the
             broadcast (only the default SMS app's SMS_DELIVER can, see T14), so the inbox
             copy still appears; it only decides who runs first. -->
        <receiver
            android:name=".core.services.ImpartSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Default SMS app mode (T14). SMS_DELIVER reaches only the default SMS app; an alert
             is verified and never written to the provider, so no inbox copy exists. -->
        <receiver
            android:name=".core.sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.sms.MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service
            android:name=".core.sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Exported without a permission because the role requires a SENDTO handler any app
             can open. It only forwards the number to MainActivity, behind the lock, and
             finishes. manifest-check.sh lists it as an allowed exported component. -->
        <activity
            android:name=".presentation.messages.ComposeSmsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".core.services.SmsSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.uncoalesced.impart.SMS_SENT" />
            </intent-filter>
        </receiver>

        <!-- ImpartApplication implements Configuration.Provider, so WorkManager is
             initialised on demand with the HiltWorkerFactory. The default startup
             initializer must be removed or it wins the race and the dead man's switch
             workers are built without Hilt injection. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
            <!-- EmojiCompat would ask a font provider for downloadable emoji fonts. Impart
                 bundles its fonts and shows no emoji, so the initializer goes. -->
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
