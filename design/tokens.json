{
  "_source": "Derived from E:\\uncoalescedDZN\\Logos\\uncoalescedlogo.png and E:\\uncoalescedDZN\\Branding\\dimentions.png",
  "color": {
    "graphite": {
      "hex": "#333333",
      "role": "field / background. Default ground for every mark."
    },
    "porcelain": {
      "hex": "#FDFFFC",
      "role": "wordmark ink on dark ground; background for light variant."
    },
    "palmLeaf": {
      "hex": "#748E54",
      "role": "primary accent",
      "weight": 0.45
    },
    "sandyBrown": {
      "hex": "#F19143",
      "role": "secondary accent",
      "weight": 0.26
    },
    "watermelon": {
      "hex": "#EF2D56",
      "role": "tertiary accent, used sparingly",
      "weight": 0.24
    },
    "moss": {
      "hex": "#B28F4B",
      "role": "blend accent, texture only",
      "weight": 0.05,
      "derivation": "50/50 blend of palmLeaf + sandyBrown — never hand-picked, always computed"
    }
  },
  "grid": {
    "columns": 9,
    "rows": 9,
    "cellSize": 100,
    "canvas": 900,
    "centerCell": [
      4,
      4
    ],
    "centerRule": "Center cell is always empty. The mark never fully coalesces — that hole is the concept, not a bug.",
    "gridLines": "Construction guide only. Never rendered in shipped artwork.",
    "fillRateTarget": 0.47,
    "densityFalloff": "Manhattan distance from center cell; fill probability decreases with distance, producing a diamond-shaped bloom (sparse corners/edges, dense middle band).",
    "variants": {
      "standard": {
        "columns": 9,
        "rows": 9,
        "cellSize": 100,
        "canvas": 900,
        "centerCell": [
          4,
          4
        ]
      },
      "large": {
        "columns": 18,
        "rows": 18,
        "cellSize": 50,
        "canvas": 900,
        "centerHole": [
          [
            8,
            8
          ],
          [
            8,
            9
          ],
          [
            9,
            8
          ],
          [
            9,
            9
          ]
        ],
        "note": "for bigger / more complex products: same physical canvas, finer mosaic so a figurative or denser mark has room to read clearly. 18 is even, so the 'center never coalesces' rule becomes a 2x2 hole instead of one cell."
      }
    }
  },
  "shape": {
    "circleDiameterRatio": 0.62,
    "squareSideRatio": 0.66,
    "squareCornerRadiusRatio": 0.12,
    "mix": {
      "circle": 0.63,
      "square": 0.37
    }
  },
  "typography": {
    "wordmark": "lowercase, monospace — note the serif'd lowercase L reading almost like a '1'",
    "recommended": "JetBrains Mono",
    "fallback": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace",
    "note": "Closest open-source match to the existing wordmark. Confirm against the original font file if one exists before locking this in."
  },
  "productAccentSystem": {
    "rule": "A sub-product never invents its own palette. It picks exactly one core chromatic color (palmLeaf | sandyBrown | watermelon | moss) as its signature, and its mark is generated in mode='product' — a shade/accent/tint ramp of that single hue — instead of the full multi-hue parent palette. Structure (grid, shapes, density) stays identical to the parent mark; only the hue narrows.",
    "assigned": {
      "peridot": "palmLeaf",
      "impart": "watermelon",
      "fluxboard": "watermelon",
      "nexus": "moss",
      "parentheses": "sandyBrown",
      "dipteran": "sandyBrown"
    },
    "note": "Peridot shares Palm Leaf with Impart — fine, since Peridot's mark is a fixed hexagon glyph (not free scatter), so shape carries the distinction, not the hue. None of the pre-existing products currently follow this rule yet — each picked an unrelated palette from scratch. Re-skinning them onto their assigned hue is the fix.",
    "impartNote": "Impart moved from palmLeaf to watermelon on 2026-11-04 at Joel's request: it is an emergency product, so the alarm hue is its identity. It shares watermelon with FluxBoard; shape carries the distinction (Impart's mark is the fixed pointer glyph in design/impart-mark.cells.json, not free scatter)."
  },
  "glyphs": {
    "_description": "mode='glyph' marks: fixed cell positions (unlike parent/product's random scatter), still random shape + single-hue ramp color per cell each generation. Cells are [row, col], 0-indexed on the 9x9 grid. Kept deliberately thin — one cell per row, no thickening — after a bulkier first pass read wrong.",
    "parentheses": {
      "description": "Two parenthesis curves, mirror-symmetric in position (column 4 is never touched by either curve, so the center-empty rule holds structurally). The asymmetry lives in shape and color instead: circle/square placement is independent per side, not mirrored, and the shipped asset uses flat #F19143 (sandyBrown base, no shade/tint ramp) rather than the usual 3-tone product ramp — a deliberate one-off for this mark.",
