  "vectorMarks": {
    "_description": "Bespoke marks built as true vector geometry instead of the 9x9 cell grid — for shapes the grid can only stair-step, never render crisp. First (and so far only) case: a regular hexagon, which needs true 120° vertices, not a cell-mosaic approximation. Still follows the family's texture rule (single accent hue, shade/base/tint ramp) and its own version of the grid glyphs' center-differentiation rule (one small circle in a second, distinct hue sitting exactly at the shape's center) — same ideas, expressed in vector form rather than on the grid. Superseded a first attempt (a thin ring traced in grid cells, tokens history) that read as generic dots-in-a-circle and was too close to the Parentheses glyph's own two-column ring; true polygon vertices read as a hexagon at a glance instead.",
    "peridotHex": {
      "description": "Regular pointy-top hexagon, drawn as 6 triangular wedges fanning out from the center point to each pair of adjacent vertices (like a cut-gem top view — apt for a mark named after a gemstone). Wedges alternate around the ring through the accent's shade/base/tint ramp so no two neighbors match. A small circle sits exactly on the center point in a second, distinct hue, breaking the fan apart at the middle — directly echoes the original hand-drawn Peridot mark (hexagon outline + separate center dot).",
      "vertexCount": 6,
      "rotationDeg": -90,
      "radiusRatio": 0.3667,
      "toneSequence": [
        "shade",
        "base",
        "tint",
        "shade",
        "base",
        "tint"
      ],
      "centerDotRatio": 0.0689,
      "centerColor": "moss"
    }
  },
